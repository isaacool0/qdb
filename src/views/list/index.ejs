<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Search Results</title>
  <link rel="stylesheet" href="/css/list.css">
</head>
<body>
<%- include('../partials/header') %>
<main class="list">
  <h1>Search Results</h1>
  <p class="tags">
    <% results.tags.forEach(tag => { %><a href="/list/<%= tag.name %>"><%= tag.name %></a><% }) %>
  </p>
  <table>
    <thead>
      <tr><th>Rank</th><th>Item</th><th>Votes</th></tr>
    </thead>
    <tbody>
      <% results.items.forEach((item, i) => { %>
        <tr class="votable">
          <td class="rank"><%= (page - 1) * size + i + 1 %></td>
          <td>
            <a class="item" href="/item/<%= item.name %>">
              <% if (item.image) { %>
                <img src="/uploads/<%= item.image %>.avif" alt="">
              <% } else { %>
                <span class="thumb"><%= item.name.charAt(0).toUpperCase() %></span>
              <% } %>
              <%= item.name %>
            </a>
          </td>
          <td>
            <span class="vote-msg" id="vote-<%= item.id %>"></span>
            <button onclick='vote(["<%= item.id %>", [<%- results.tags.map(tag => `"${tag.id}"`).join(",") %>]], 1, "tag", "<%= item.id %>")'>▲</button>
            <span class="vote-score" id="count-<%= item.id %>"><%= Math.round(item.up - item.down) %></span>
            <button onclick='vote(["<%= item.id %>", [<%- results.tags.map(tag => `"${tag.id}"`).join(",") %>]], 0, "tag", "<%= item.id %>")'>▼</button>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <p class="pager">
    <% if (page > 1) { %><a href="?page=<%= page - 1 %>">Previous</a><% } %>
    Page <%= page %>
    <% if (results.items.length === size) { %><a href="?page=<%= page + 1 %>">Next</a><% } %>
  </p>
</main>
<script src="/js/vote.js"></script>
</body>
</html>


