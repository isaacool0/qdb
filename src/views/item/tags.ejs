<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= name %> tags</title>
</head>
<body>
<%- include('../partials/header') %>
	<h1><%= name %></h1>
	<p>tags:</p>
	  <ul>
	  <% tags.forEach(tag => { %>
			<li id='<%= tag.id %>'><a href="/list/<%= tag.name %>/top"><%= tag.name %></a>
			<button onclick="vote(['<%= id %>', '<%= tag.id %>'], 1, 'tag', '<%= tag.id %>')">↑</button>
			<button onclick="vote(['<%= id %>', '<%= tag.id %>'], 0, 'tag', '<%= tag.id %>')">↓</button>
			<span id="count-<%= tag.id %>"><%= tag.up - tag.down %></span>
			<span id="vote-<%= tag.id %>"></span></li>
	  <% }) %>
	</ul>
	<a href=".">back</a><br>
	<a href="/">search</a>
<script src="/js/vote.js"></script>
</body>
</html>
